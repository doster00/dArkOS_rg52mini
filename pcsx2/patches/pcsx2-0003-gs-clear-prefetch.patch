+// The masked and 24-bit clears below read, mask and write back whole pages of GS memory, which
+// is seldom in the cache. On an in-order core (the Cortex-A53) every 16-byte load then waits for
+// DRAM - four fifths of this function's time in God of War - as its prefetcher does not get far
+// enough ahead of the stream. Each line is asked for a kilobyte before the loop reaches it.
+static __forceinline void ClearGSLocalMemoryMaskedRun(GSVector4i* ptr, GSVector4i* const end, const GSVector4i& mask, const GSVector4i& vcolor)
+{
+	constexpr int ahead = 1024 / sizeof(GSVector4i);
+	while (end - ptr >= 4)
+	{
+		__builtin_prefetch(ptr + ahead, 1, 3);
+		ptr[0] = (ptr[0] & mask) | vcolor;
+		ptr[1] = (ptr[1] & mask) | vcolor;
+		ptr[2] = (ptr[2] & mask) | vcolor;
+		ptr[3] = (ptr[3] & mask) | vcolor;
+		ptr += 4;
+	}
+	while (ptr != end)
+	{
+		*ptr = (*ptr & mask) | vcolor;
+		ptr++;
+	}
+}
