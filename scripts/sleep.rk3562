#!/bin/bash
#
# Sleep/wake script for RK3562 (RG52 Mini)
# Handles suspend/resume for RK817 PMIC and peripherals
#

# The way down takes a few seconds, with the screen dark from the start. A
# press of the power key in that time (pause.sh) used to be lost, and the
# system went to sleep anyway, so waking it took a second press. pause.sh
# reads the phase from this file: on the way down a press asks to come back,
# which the RTC alarm does right after the system is asleep.
PHASE=/run/darkos-sleep.phase
WAKE=/run/darkos-sleep.wake
RTC_ALARM=/sys/class/rtc/rtc0/wakealarm

# Two hours asleep on battery, and the device powers off: deep sleep still
# draws ~42 mA, an empty battery in about 4.5 days (KNOWN-ISSUES). A game left
# suspended is lost then. The RTC alarm wakes the system for it at the time in
# OFF, which stays over the wakes that put it back to sleep (post).
OFF=/run/darkos-sleep.off
OFF_AFTER=7200

# "systemctl $1" once this wake is through: logind refuses a power-off or a
# suspend while the suspend is in progress ("Action suspend already in
# progress"), so retry for up to 30 s. In a unit of its own, as systemd stops
# what is left in the cgroup of systemd-suspend.service.
after_wake() {
  systemd-run --no-block --collect bash -c "for i in \$(seq 1 60); do sleep 0.5; pgrep -x systemd-sleep > /dev/null && continue; systemctl $1 && break; done" > /dev/null 2>&1
}

case $1 in
   pre)
    echo "pre $(date +%s%3N)" > $PHASE
    rm -f $WAKE

    # Save current brightness and turn off backlight. Already off, it is the
    # "black" screensaver of ES, and the one to save is from before it (udev
    # keeps it, see finishing_touches-rk3562.sh): a 0 would leave the screen
    # dark after the wake.
    b=$(cat /sys/class/backlight/backlight/brightness)
    [ "$b" = 0 ] && b=$(cat /run/darkos-brightness 2> /dev/null)
    [ -n "$b" ] && [ "$b" != 0 ] && echo $b | sudo tee /var/local/cur_bright.state
    echo 0 | sudo tee /sys/class/backlight/backlight/brightness

    # Check if EmulationStation is using too much CPU (stuck); with ES not
    # running (a test, a port that stopped it) there is nothing to check
    es=$(pidof -s emulationstation)
    if [ -n "$es" ]; then
      test=$(top -b -n 1 -d 0.2 -p $es | tail -1 | awk '{print $9}')
      test=${test%.*}
      if (( ${test:-0} > 100 )); then
        systemctl stop emulationstation
      fi
    fi

    # Ensure Resume Path is enabled so RK817 codec restores audio on wake
    amixer -q sset 'Resume Path' ON 2>/dev/null

    # Save audio state
    /usr/sbin/alsactl store -f /var/local/asound.state

    # Set quick mode marker if applicable
    if [ -f "/usr/local/bin/quickmode.sh" ]; then
      touch /dev/shm/.JUSTWOKEUP
    fi

    # Check Bluetooth connection
    sudo btconnected.sh check

    # Save governor settings before sleep
    sudo sleep_governors.sh SaveSettingsOnSleep

    # Turn off power LEDs during sleep
    # GPIO3_A0 (green) = bank 3 * 32 + pin 0 = 96
    # GPIO3_A1 (red)   = bank 3 * 32 + pin 1 = 97
    # U-Boot sets green=charged, red=charging; save state to restore on wake.
    # The pins are exported on the first sleep after boot, and an export leaves
    # them as U-Boot set them, so their state is read before anything is
    # written: "out" as the direction drives a pin low, and it used to come
    # first, which saved a 0 and left the LEDs off after every wake. "low"
    # makes the pin an output and turns the LED off in one write.
    for gpio in 96 97; do
      [ -d /sys/class/gpio/gpio${gpio} ] || echo ${gpio} > /sys/class/gpio/export 2>/dev/null
    done
    cat /sys/class/gpio/gpio96/value > /var/local/led_green.state 2>/dev/null
    cat /sys/class/gpio/gpio97/value > /var/local/led_red.state 2>/dev/null
    echo low > /sys/class/gpio/gpio96/direction 2>/dev/null
    echo low > /sys/class/gpio/gpio97/direction 2>/dev/null

    # Power down the stick-RGB LED MCU during sleep (no-op unless configured)
    [ -f /home/ark/.config/led.cfg ] && /usr/local/bin/ledctl suspend 2>/dev/null

    # The alarm for the power-off, on the charger too: it may be unplugged in
    # the meantime.
    t=
    read -r t 2> /dev/null < $OFF
    [ -n "$t" ] && [ "$t" -gt $(date +%s) ] || t=$(( $(date +%s) + OFF_AFTER ))
    echo $t > $OFF
    echo 0 > $RTC_ALARM 2>/dev/null
    echo $t > $RTC_ALARM 2>/dev/null

    # The power key was pressed on the way down: wake a second after.
    echo "asleep $(date +%s%3N)" > $PHASE
    if [ -e $WAKE ]; then
      echo 0 > $RTC_ALARM 2>/dev/null
      echo +1 > $RTC_ALARM 2>/dev/null
    fi
    exit 0
    ;;

   post)
    echo "post $(date +%s%3N)" > $PHASE
    echo 0 > $RTC_ALARM 2>/dev/null
    rm -f $WAKE

    # What woke the system. The alarm of pre: on battery, power off; on the
    # charger, sleep for another two hours. The cable, charger in or out (the
    # USB-C controller husb311 among the causes; the power key and the RTC are
    # both rk817): back to sleep, the screen left dark, the time to the
    # power-off running on. Anything else is a press, and the device wakes.
    back=
    t=
    read -r t 2> /dev/null < $OFF
    if [ -n "$t" ] && [ $(date +%s) -ge $(( t - 5 )) ]; then
      rm -f $OFF
      if [ "$(cat /sys/class/power_supply/battery/status)" = Discharging ]; then
        logger -t darkos-sleep "asleep for $OFF_AFTER s on battery: powering off"
        rm -f $PHASE
        after_wake poweroff
        exit 0
      fi
      back=1
    elif dmesg | awk '/PM: suspend entry/ {c = ""} /Resume caused by IRQ/ {c = c " " $NF} END {print c}' | grep -qw husb311; then
      back=1
    else
      rm -f $OFF
    fi
    [ -n "$back" ] && logger -t darkos-sleep "woken by the alarm on the charger or by the cable: back to sleep"

    # Restore power LEDs after wake (saved state from pre-suspend)
    # Re-ensure direction is "out" — GPIO controller may reset on resume
    echo out > /sys/class/gpio/gpio96/direction 2>/dev/null
    echo out > /sys/class/gpio/gpio97/direction 2>/dev/null
    if [ -f /var/local/led_green.state ]; then
      cat /var/local/led_green.state > /sys/class/gpio/gpio96/value 2>/dev/null
    else
      echo 1 > /sys/class/gpio/gpio96/value 2>/dev/null
    fi
    if [ -f /var/local/led_red.state ]; then
      cat /var/local/led_red.state > /sys/class/gpio/gpio97/value 2>/dev/null
    else
      echo 0 > /sys/class/gpio/gpio97/value 2>/dev/null
    fi

    # Restore the stick-RGB LED state on wake (no-op unless configured)
    [ -f /home/ark/.config/led.cfg ] && /usr/local/bin/ledctl apply 2>/dev/null

    # Restore brightness, unless the "black" screensaver of ES is still on: then
    # no press woke the system (the RTC alarm, the charger), or ES takes the
    # press, and its wake script lights the screen (Emulationstation/
    # scripts.rk3562). screensaver-autosleep puts it back to sleep on battery.
    read -r s _ pid 2> /dev/null < /run/darkos-screensaver
    if [ -z "$back" ] && { [ "$s" != on ] || ! kill -0 "$pid" 2> /dev/null; }; then
      echo $(cat /var/local/cur_bright.state) | sudo tee /sys/class/backlight/backlight/brightness
    fi

    # Restore governor settings
    sudo sleep_governors.sh RestoreSettingsOnWake

    # Restore audio state
    sudo /usr/sbin/alsactl restore -f /var/local/asound.state

    # Re-apply panel color-temperature LUT to VOP2 (CRTC state is reset
    # across suspend; the gamma table loses its programming on resume).
    # No-op on devices without panel-lut installed.
    if [ -x /usr/local/bin/apply-panel-lut ] && [ -f /etc/panel-lut/current.lut ]; then
      sudo /usr/local/bin/apply-panel-lut /etc/panel-lut/current.lut >/dev/null 2>&1 &
    fi

    # Restart EmulationStation if needed
    if [ ! -f "/dev/shm/QBMODE" ]; then
      systemctl is-active --quiet emulationstation.service && echo ok || systemctl start emulationstation
    fi

    sleep 2

    # Restart Bluetooth services if active
    systemctl is-active --quiet enable_bluetooth.service && sudo systemctl restart enable_bluetooth
    systemctl is-active --quiet bluetooth.service && sudo systemctl restart bluetooth
    systemctl is-active --quiet bluealsa.service && sudo systemctl restart bluealsa
    systemctl is-active --quiet watchforbtaudio.service && sudo systemctl restart watchforbtaudio --no-block

    # Auto-reconnect Bluetooth if configured
    if [ -f "/var/local/btautoreconnect.state" ]; then
      sleep 15
      sudo btconnected.sh reconnect
      sudo rm -f /var/local/btautoreconnect.state
    fi

    # Restart killer daemon if active
    systemctl is-active --quiet killer_daemon && sudo systemctl restart killer_daemon
    rm -f $PHASE

    [ -n "$back" ] && after_wake suspend
    exit 0
    ;;
esac
