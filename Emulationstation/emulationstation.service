[Unit]
Description=EmulationStation-fcamod
After=firstboot.service

[Service]
Type=simple
User=ark
WorkingDirectory=/home/ark
ExecStart=/usr/bin/emulationstation/emulationstation.sh
Environment="SDL_VIDEO_EGL_DRIVER=libEGL.so"
# es_systems.cfg starts emulators with "nice -n -19", and limits.conf gives ark
# nice -20, but that is pam_limits and a service has no PAM session: without
# this the limit is 0 and every nice -19 fails, leaving emulators at nice 0.
LimitNICE=-20
Restart=on-failure
# Stopping ES (the power key's poweroff, a shutdown, an update) sends SIGTERM to
# the game it started too. RetroArch saves and quits on it in a second or two,
# but with mupen64plus_next it hung until systemd's default 90 s ran out, so a
# poweroff during an N64 game took a minute and a half.
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
