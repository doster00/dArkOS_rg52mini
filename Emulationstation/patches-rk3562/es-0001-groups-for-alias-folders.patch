From: dArkOS RG52 Mini port
Subject: Groups only when two of their systems have games; main system name and place

scripts/rk3562/es-aliases.py adds systems for ROM folders other front ends
name differently (GammaOS/ES-DE: tg16, megacd, fbneo ...) and groups each
with the system dArkOS uses, e.g. <group>arcade</group> on arcade and fbneo.
Upstream would turn every such system into a group of one, a level deeper,
listed at the end under the bare group name. Here:

- a group is made only when two or more of its systems have games; otherwise
  each stays an ordinary system;
- the group takes the metadata (full name, theme, manufacturer ...) and the
  place in the list of the system named like it;
- its folders are named after their systems ("FinalBurn Neo"), not after the
  directories;
- EMULATOR SETTINGS leaves the group out: it has no emulators of its own, and
  with the main system's name it was a second entry that looked like that one
  and did nothing.

diff --git a/es-app/src/SystemData.cpp b/es-app/src/SystemData.cpp
index e407754..ff3c190 100644
--- a/es-app/src/SystemData.cpp
+++ b/es-app/src/SystemData.cpp
@@ -406,6 +406,28 @@ void SystemData::createGroupedSystems()
 
 	for (auto item : map)
 	{
+		// dArkOS: a group is only worth a level in the menus when two or more
+		// of its systems have games. Otherwise they stay ordinary systems, so
+		// a card without the alias folders looks as it did before.
+		int withGames = 0;
+		for (auto childSystem : item.second)
+			if (childSystem->getRootFolder()->getChildren().size() > 0)
+				withGames++;
+
+		if (withGames < 2)
+		{
+			for (auto childSystem : item.second)
+				childSystem->getSystemEnvData()->mGroup = "";
+			continue;
+		}
+
+		// The system named like the group is its main one: the group takes its
+		// name, theme and place, so it sorts and looks like that system did.
+		SystemData* mainSystem = nullptr;
+		for (auto childSystem : item.second)
+			if (childSystem->getName() == item.first)
+				mainSystem = childSystem;
+
 		SystemEnvironmentData* envData = new SystemEnvironmentData;
 		envData->mStartPath = "";
 		envData->mLaunchCommand = "";
@@ -414,6 +436,10 @@ void SystemData::createGroupedSystems()
 		md.name = item.first;
 		md.fullName = item.first;
 		md.themeFolder = item.first;
+		md.releaseYear = 0;
+		if (mainSystem != nullptr)
+			md = mainSystem->getSystemMetadata();
+		md.name = item.first;
 
 		SystemData* system = new SystemData(md, envData, false, true);
 		system->mIsGroupSystem = true;
@@ -427,6 +453,7 @@ void SystemData::createGroupedSystems()
 			if (children.size() > 0)
 			{
 				auto folder = new FolderData(childSystem->getRootFolder()->getPath(), childSystem, false);
+				folder->setMetadata("name", childSystem->getFullName());
 				root->addChild(folder);
 
 				auto theme = childSystem->getTheme();
@@ -451,7 +478,9 @@ void SystemData::createGroupedSystems()
 		if (root->getChildren().size() > 0)
 		{
 			system->loadTheme();
-			sSystemVector.push_back(system);
+			auto pos = std::find(sSystemVector.begin(), sSystemVector.end(),
+				mainSystem != nullptr ? mainSystem : item.second.front());
+			sSystemVector.insert(pos, system);
 		}
 	}
 }
diff --git a/es-app/src/guis/GuiMenu.cpp b/es-app/src/guis/GuiMenu.cpp
--- a/es-app/src/guis/GuiMenu.cpp
+++ b/es-app/src/guis/GuiMenu.cpp
@@ -1893,6 +1893,11 @@
 		if (system->getName() == "options")
 			continue;
 
+		// dArkOS: a group has no emulators of its own (its envData is empty);
+		// each of its systems has an entry here, under its own name.
+		if (system->isGroupSystem())
+			continue;
+
 		/*if (system->getSystemEnvData()->mEmulators.size() == 0)
 			continue;*/
 
