dArkOS: EMULATOR SETTINGS offers a VULKAN DRIVER choice (AUTO, MALI, MALISX2) for the systems
/etc/darkos/vulkan.conf names on its es_systems line (comma-separated; editable on the device).
The choice is kept as "<system>.vulkan" like the governor, and a game of the system is launched
with DARKOS_VULKAN set to it, which libvulkan_darkos.so (vk-driver-select/) reads; AUTO leaves
DARKOS_VULKAN unset, so vulkan.conf's lines decide.

diff --git a/es-app/src/DarkosVulkan.h b/es-app/src/DarkosVulkan.h
new file mode 100644
index 0000000..3cec646
--- /dev/null
+++ b/es-app/src/DarkosVulkan.h
@@ -0,0 +1,53 @@
+#pragma once
+#ifndef ES_APP_DARKOS_VULKAN_H
+#define ES_APP_DARKOS_VULKAN_H
+
+// dArkOS: the Vulkan driver a system's emulators get. libvulkan_darkos.so, the driver the Vulkan
+// loader sees, loads Arm's (mali) or malisx2: DARKOS_VULKAN in the program's environment if set,
+// else /etc/darkos/vulkan.conf. EMULATOR SETTINGS offers the choice for the systems that file names
+// on its "es_systems" line (editable on the device); AUTO leaves it to the file.
+
+#include <fstream>
+#include <sstream>
+#include <string>
+
+namespace DarkosVulkan
+{
+	inline std::string trim(const std::string& s)
+	{
+		const size_t a = s.find_first_not_of(" \t\r\n");
+		if (a == std::string::npos)
+			return "";
+		return s.substr(a, s.find_last_not_of(" \t\r\n") - a + 1);
+	}
+
+	// The value of "key = value" in vulkan.conf, "" if it has none.
+	inline std::string confValue(const std::string& key)
+	{
+		std::ifstream f("/etc/darkos/vulkan.conf");
+		std::string line, value;
+		while (std::getline(f, line))
+		{
+			const size_t hash = line.find('#');
+			if (hash != std::string::npos)
+				line.erase(hash);
+			const size_t eq = line.find('=');
+			if (eq != std::string::npos && trim(line.substr(0, eq)) == key)
+				value = trim(line.substr(eq + 1));
+		}
+		return value;
+	}
+
+	// es_systems is a comma-separated list: a system's name may hold spaces ("Sega Atomiswave").
+	inline bool offered(const std::string& system)
+	{
+		std::istringstream names(confValue("es_systems"));
+		std::string name;
+		while (std::getline(names, name, ','))
+			if (trim(name) == system)
+				return true;
+		return false;
+	}
+}
+
+#endif
