 	LOG(LogInfo) << "	" << command;
 
+	// dArkOS: the system's Vulkan driver for libvulkan_darkos.so (DarkosVulkan.h); AUTO (unset)
+	// leaves it to /etc/darkos/vulkan.conf
+	const std::string vulkan = Settings::getInstance()->getString(getSystemName() + ".vulkan");
+	if (vulkan == "mali" || vulkan == "malisx2")
+		setenv("DARKOS_VULKAN", vulkan.c_str(), 1);
+	else
+		unsetenv("DARKOS_VULKAN");
+
 	int exitCode = runSystemCommand(command, getDisplayName(), hideWindow ? NULL : window);
+	unsetenv("DARKOS_VULKAN");
 	if (exitCode != 0)
 	{
